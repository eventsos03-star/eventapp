{
  "name": "eventos",
  "version": "1.0.0",
  "private": true,
  "description": "EventOS — full-stack app (Express + TypeScript backend, Next.js + React frontend)",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "install:all": "npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "all": "^0.0.0",
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^4.3.0",
    "append-field": "^1.0.0",
    "base64-js": "^1.5.1",
    "bowser": "^2.14.1",
    "buffer": "^5.6.0",
    "busboy": "^1.6.0",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "emoji-regex": "^8.0.0",
    "escalade": "^3.2.0",
    "events": "^3.3.0",
    "get-caller-file": "^2.0.5",
    "has-flag": "^4.0.0",
    "ieee754": "^1.2.1",
    "inherits": "^2.0.4",
    "is-fullwidth-code-point": "^3.0.0",
    "media-typer": "^0.3.0",
    "mime-db": "^1.52.0",
    "mime-types": "^2.1.35",
    "multer": "^2.4.0",
    "readable-stream": "^3.6.2",
    "require-directory": "^2.1.1",
    "rxjs": "^7.8.2",
    "safe-buffer": "^5.2.1",
    "shell-quote": "^1.9.0",
    "stream-browserify": "^3.0.0",
    "streamsearch": "^1.1.0",
    "string_decoder": "^1.3.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "type-is": "^1.6.18",
    "util-deprecate": "^1.0.2",
    "wrap-ansi": "^7.0.0",
    "y18n": "^5.0.8",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eventsos03-star/eventapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/eventsos03-star/eventapp/issues"
  },
  "homepage": "https://github.com/eventsos03-star/eventapp#readme"
}
