# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/eventos

# JWT (must be at least 32 characters each)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Token expiry
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=30d

# SMTP (real delivery — works with Gmail, Resend, or any SMTP provider)
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=your@gmail.com  SMTP_PASS=<16-char App Password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=EventOS <your@gmail.com>

# Google OAuth client ID (from Google Cloud Console → Credentials → OAuth client ID)
# Used to verify Google ID tokens. The frontend needs the same value.
GOOGLE_CLIENT_ID=

# AWS S3 (venue image uploads)
# Bucket must be created manually in the AWS console — the app never creates it.
# The bucket needs a public-read policy on the venue-images/ prefix so image
# URLs are displayable in the frontend (see final report for the exact policy).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Frontend
CLIENT_URL=http://localhost:3000
