{
  "name": "eventos-auth",
  "version": "1.0.0",
  "description": "Authentication backend for EventOS",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
